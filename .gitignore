defendskin_work/_prev_*.json
# 临时骨架 dump
defendskin_work/_*.skel
# 从游戏提取的原始 ctex 与 atlas 文本
defendskin_work/*_ctex.bin
defendskin_work/*.spatlas.txt
defendskin_work/_ship.atlas.bin
# 从游戏导出的场景/资源 dump（_dump/、_ship_*.tscn 为原版资源）
defendskin_work/_dump/
defendskin_work/_ship_*.tscn

